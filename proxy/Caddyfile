# HTTPS in front of the app. Certificates come from Caddy's own local certificate authority
# ("tls internal"), so it works on a LAN without a public domain. Devices must trust that CA once,
# see README ("Verschlüsselung"). Ports and names come from .env.
{
	local_certs
	admin off
	auto_https disable_redirects
	https_port {$HTTPS_PORT:8443}
	http_port {$HTTP_PORT:8080}
	# Browsers send no server name when you type an IP address; they get this certificate then.
	default_sni {$SITE_ADDRESS:localhost}
}

# Plain HTTP only redirects to HTTPS (keeping the port, which Caddy's automatic redirect does not).
http://:{$HTTP_PORT:8080} {
	redir https://{host}:{$HTTPS_PORT:8443}{uri} permanent
}

# SITE_ADDRESS is the main name/IP the tablets use (e.g. 192.168.1.50), SITE_ALIASES more names.
{$SITE_ADDRESS:localhost} {$SITE_ALIASES:127.0.0.1} {
	tls internal
	encode zstd gzip

	header {
		-Server
	}

	reverse_proxy app:8080 {
		# the app only ever talks to this proxy
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
