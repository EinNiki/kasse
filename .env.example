# Copy to .env, change ALL passwords and run: chmod 600 .env
POSTGRES_USER=kasse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kasse

# Restricted database role the web app runs with (created automatically at startup).
# It cannot change the schema and can only append to sales and stock movements.
APP_DB_USER=kasse_app
APP_DB_PASSWORD=change-me-app

# The app is only reachable through the HTTPS proxy: https://localhost:8443
# SITE_ADDRESS: the name or IP the tablets use (e.g. 192.168.1.50), SITE_ALIASES: more names, space separated.
# The certificate covers exactly these.
SITE_ADDRESS=localhost
SITE_ALIASES=127.0.0.1
HTTPS_PORT=8443
# Plain HTTP port, it only redirects to HTTPS
APP_PORT=8080

# First admin, created on first start only if no user exists yet
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-too

# Session cookies only travel over HTTPS (keep true; the proxy always serves HTTPS)
COOKIE_SECURE=true
