# Copy to .env, change ALL passwords and run: chmod 600 .env
# The app refuses to start while a password still starts with "change-me".

# Image version: dev, latest or a release like 1.0.0
KASSE_VERSION=dev

POSTGRES_USER=kasse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kasse

# Restricted database role the web app runs with (created automatically at startup).
# It cannot change the schema and can only append to sales and stock movements.
APP_DB_USER=kasse_app
APP_DB_PASSWORD=change-me-app

# First admin, created on first start only if no user exists yet
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-too

# Port on this host for your reverse proxy (plain HTTP)
APP_PORT=8080

# Session cookies only travel over HTTPS. Keep true: your reverse proxy serves HTTPS.
COOKIE_SECURE=true
