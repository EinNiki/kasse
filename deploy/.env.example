# Copy to .env and change EVERY password (or run ./setup.sh which does it for you).
# Then: chmod 600 .env && docker compose up -d

# ---- Database ----
POSTGRES_USER=kasse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kasse
# Restricted role the web app runs with (created automatically)
APP_DB_USER=kasse_app
APP_DB_PASSWORD=change-me-too

# ---- First login (created on first start only, if no user exists yet) ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-as-well

# ---- Network ----
# The name or IP the tablets type in (e.g. 192.168.1.50). The certificate covers exactly these names.
SITE_ADDRESS=localhost
SITE_ALIASES=127.0.0.1
HTTPS_PORT=8443
# plain HTTP port, only redirects to HTTPS
HTTP_PORT=8080

# ---- Image (optional) ----
# KASSE_IMAGE=ghcr.io/einniki/kasse:latest   # or :dev, or a version like :v1.0.0
